generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EsemenyTipus {
  TELEPITES
  KIVETEL
  ETETES
  // Halászati napló 2.0 — visszafelé kompatibilis bővítés.
  // Jelenleg csak a TAKARMANY_BEVETEL / TAKARMANY_FELHASZNALAS keletkezik
  // ténylegesen (takarmánymozgásból); a többi érték a jövőbeli modulokhoz
  // van előkészítve (esemény NEM jön létre hozzájuk, amíg a modul nincs kész).
  ATTELEPITES
  TAKARMANY_BEVETEL
  TAKARMANY_FELHASZNALAS
  TAKARMANY_KORREKCIO
  VIZMINOSEG_MERES
  ELHULLAS
  MADARKAR
  HALKELTES
  FELADAT
  HIBABEJELENTES
  RIASZTAS
  EGYEB
}

enum TakarmanyMozgasTipus {
  BEVETEL
  FELHASZNALVA
}

enum Szerepkor {
  OWNER
  ADMIN
  STAFF
  OR
  ANGLER
}

enum HalaszatSzerepkor {
  OWNER
  ADMIN
  STAFF
}

enum ToTipus {
  TO
  TELELO
  IVADEKNEVELO
  KELTETO_MEDENCE
}

model Felhasznalo {
  azonosito  Int      @id @default(autoincrement())
  email      String   @unique @db.VarChar(255)
  nev        String?  @db.VarChar(120)
  jelszoHash String   @db.VarChar(255)
  aktiv      Boolean  @default(true)
  letrehozva DateTime @default(now())
  frissitve  DateTime @updatedAt

  // relációk
  sessions          Session[]
  tagsagok          ToTagsag[]
  halaszatTagsag    HalaszatTagsag[]
  hibabejelentesek  Hibabejelentes[]
  naploEsemenyek         NaploEsemeny[]    @relation("NaploRogzito")
  naploErvenytelenitesek NaploEsemeny[]    @relation("NaploErvenytelenito")
  naploSzerkesztesek     NaploEsemeny[]    @relation("NaploSzerkeszto")
  takarmanyMozgasok      TakarmanyMozgas[]
  halkeltetesCiklusok    HalkeltetesCiklus[]
  felelosFeladatok       Feladat[]         @relation("FeladatFelelos")
  letrehozottFeladatok   Feladat[]         @relation("FeladatLetrehozo")

  @@map("felhasznalok")
}

model Session {
  azonosito     Int      @id @default(autoincrement())
  felhasznaloId Int
  tokenHash     String   @unique @db.VarChar(255)
  lejar         DateTime
  letrehozva    DateTime @default(now())

  // reláció
  felhasznalo Felhasznalo @relation(fields: [felhasznaloId], references: [azonosito], onDelete: Cascade)

  @@index([felhasznaloId])
  @@map("sessions")
}

model Halaszat {
  azonosito  Int      @id @default(autoincrement())
  nev        String   @db.VarChar(160)
  slug       String   @unique @db.VarChar(190)
  aktiv      Boolean  @default(true)
  letrehozva DateTime @default(now())
  frissitve  DateTime @updatedAt

  // relációk
  toak               To[]
  tagsagok           HalaszatTagsag[]
  hibabejelentesek   Hibabejelentes[]
  halfajok           Halfaj[]
  naptarBejegyzesek  NaptarBejegyzes[]
  takarmanyok        Takarmany[]
  takarmanyMozgasok  TakarmanyMozgas[]
  naploEsemenyek     NaploEsemeny[]
  halkeltetesCiklusok    HalkeltetesCiklus[]
  halkeltetesProtokollok HalkeltetesProtokoll[]
  feladatok          Feladat[]

  @@map("halaszatok")
}

model HalaszatTagsag {
  azonosito     Int               @id @default(autoincrement())
  halaszatId    Int
  felhasznaloId Int
  szerepkor     HalaszatSzerepkor @default(STAFF)
  aktiv         Boolean           @default(true)
  letrehozva    DateTime          @default(now())

  // relációk
  halaszat    Halaszat    @relation(fields: [halaszatId], references: [azonosito], onDelete: Cascade)
  felhasznalo Felhasznalo @relation(fields: [felhasznaloId], references: [azonosito], onDelete: Cascade)

  @@unique([halaszatId, felhasznaloId])
  @@index([felhasznaloId])
  @@index([halaszatId])
  @@map("halaszat_tagsag")
}

model To {
  azonosito  Int      @id @default(autoincrement())
  nev        String
  aktiv      Boolean  @default(true)
  letrehozva DateTime @default(now())
  frissitve  DateTime @updatedAt

  // tenant + tó típus (átmenetileg nullable a halaszatId, hogy ne boruljon régi adatokkal)
  tipus      ToTipus   @default(TO)
  halaszatId Int?
  halaszat   Halaszat? @relation(fields: [halaszatId], references: [azonosito], onDelete: Cascade)

  // Opcionális műszaki adatok a vízegység-áttekintéshez.
  // Mind nullable: a meglévő tavak érvényesek maradnak, a hiányzó érték "nincs adat".
  teruletHa          Decimal? @db.Decimal(8, 2)
  atlagMelysegMeter  Decimal? @db.Decimal(5, 2)
  kapacitasKg        Decimal? @db.Decimal(10, 2)

  // relációk
  tagsagok ToTagsag[]

  halAllomanyok     HalAllomany[]
  telepitesek       Telepites[]
  kivetelek         Kivetel[]
  etetesek          Etetes[]
  naploEsemenyek    NaploEsemeny[]
  takarmanyMozgasok TakarmanyMozgas[]
  feladatok         Feladat[]

  @@index([halaszatId])
  @@map("toak")
}

model ToTagsag {
  azonosito     Int       @id @default(autoincrement())
  felhasznaloId Int
  toId          Int
  szerepkor     Szerepkor @default(ANGLER)
  aktiv         Boolean   @default(true)
  letrehozva    DateTime  @default(now())

  // relációk
  felhasznalo Felhasznalo @relation(fields: [felhasznaloId], references: [azonosito], onDelete: Cascade)
  to          To          @relation(fields: [toId], references: [azonosito], onDelete: Cascade)

  @@unique([felhasznaloId, toId])
  @@index([toId])
  @@index([felhasznaloId])
  @@map("to_tagsag")
}

model Halfaj {
  azonosito  Int      @id @default(autoincrement())
  halaszatId Int
  nev        String   @db.VarChar(120)
  aktiv      Boolean  @default(true)
  letrehozva DateTime @default(now())
  frissitve  DateTime @updatedAt

  // reláció
  halaszat Halaszat @relation(fields: [halaszatId], references: [azonosito], onDelete: Cascade)

  // relációk
  halAllomanyok  HalAllomany[]
  telepitesek    Telepites[]
  kivetelek      Kivetel[]
  naploEsemenyek NaploEsemeny[]
  halkeltetesCiklusok    HalkeltetesCiklus[]
  halkeltetesProtokollok HalkeltetesProtokoll[]

  // tenanton belül legyen egyedi a név
  @@unique([halaszatId, nev])
  @@index([halaszatId, aktiv])
  @@map("halfajok")
}

model HalAllomany {
  azonosito  Int      @id @default(autoincrement())
  toId       Int
  halfajId   Int
  darab      Int      @default(0)
  minTomegKg Decimal  @default(0.00) @db.Decimal(6, 2)
  maxTomegKg Decimal  @default(0.00) @db.Decimal(6, 2)
  frissitve  DateTime @updatedAt

  // relációk
  to     To     @relation(fields: [toId], references: [azonosito], onDelete: Cascade)
  halfaj Halfaj @relation(fields: [halfajId], references: [azonosito], onDelete: Restrict)

  @@unique([toId, halfajId])
  @@index([toId])
  @@index([halfajId])
  @@map("hal_allomany")
}

model Telepites {
  azonosito  Int      @id @default(autoincrement())
  toId       Int
  halfajId   Int
  darab      Int
  minTomegKg Decimal  @default(0.00) @db.Decimal(6, 2)
  maxTomegKg Decimal  @default(0.00) @db.Decimal(6, 2)
  forras     String?  @db.VarChar(255)
  datum      DateTime @default(now())
  megjegyzes String?  @db.Text

  // relációk
  to     To     @relation(fields: [toId], references: [azonosito], onDelete: Cascade)
  halfaj Halfaj @relation(fields: [halfajId], references: [azonosito], onDelete: Restrict)

  @@index([toId, datum])
  @@index([halfajId, datum])
  @@map("telepitesek")
}

model Kivetel {
  azonosito  Int      @id @default(autoincrement())
  toId       Int
  halfajId   Int
  darab      Int
  ok         String?  @db.VarChar(120)
  datum      DateTime @default(now())
  megjegyzes String?  @db.Text

  // relációk
  to     To     @relation(fields: [toId], references: [azonosito], onDelete: Cascade)
  halfaj Halfaj @relation(fields: [halfajId], references: [azonosito], onDelete: Restrict)

  @@index([toId, datum])
  @@index([halfajId, datum])
  @@map("kivetelek")
}

model Etetes {
  azonosito   Int      @id @default(autoincrement())
  toId        Int
  mennyisegKg Decimal  @db.Decimal(8, 2)
  tipus       String?  @db.VarChar(120)
  datum       DateTime @default(now())
  megjegyzes  String?  @db.Text

  // opcionális kötés a felhasznált takarmányhoz (automatikus készletlevonáshoz).
  // nullable: a takarmányhoz nem kötött (régi / kézi) etetések továbbra is érvényesek.
  takarmanyId Int?

  // relációk
  to        To                @relation(fields: [toId], references: [azonosito], onDelete: Cascade)
  takarmany Takarmany?        @relation(fields: [takarmanyId], references: [azonosito], onDelete: SetNull)
  mozgasok  TakarmanyMozgas[]

  @@index([toId, datum])
  @@index([takarmanyId])
  @@map("etetesek")
}

model NaploEsemeny {
  azonosito   Int          @id @default(autoincrement())
  tipus       EsemenyTipus
  // Halászati napló 2.0: a toId nullable lett, mert vannak tóhoz nem kötött
  // események (pl. takarmány-bevétel). A tenant-kötést ilyenkor a halaszatId adja.
  toId        Int?
  halfajId    Int?
  darab       Int?
  mennyisegKg Decimal?     @db.Decimal(8, 2)
  datum       DateTime     @default(now())
  leiras      String?      @db.Text

  // Actor / nyomon követhetőség: ki rögzítette az eseményt (sessionből).
  // Nullable: régi sorok + rendszer-generált események megmaradnak.
  felhasznaloId Int?

  // Halászati napló 2.0 — mind nullable, a régi sorok érvényesek maradnak:
  halaszatId             Int?     // közvetlen tenant-kötés (tó nélküli eseményekhez is)
  cim                    String?  @db.VarChar(200) // ember-olvasható cím
  reszletekJson          Json?    // strukturált részletek (pl. takarmány neve, új készlet)
  kapcsolodoEntitasTipus String?  @db.VarChar(40)  // pl. "Etetes", "Kivetel", "TakarmanyMozgas"
  kapcsolodoEntitasId    Int?

  // ── Javítás / érvénytelenítés (audit-flow) ────────────────────────────────
  // AUDIT-ELV: a naplóbejegyzés SOSEM törlődik fizikailag. Hibás rögzítés esetén
  // érvénytelenítjük: a sor megmarad, de `ervenyes = false`, és rögzül, hogy KI,
  // MIKOR és MIÉRT érvénytelenítette. Az érvénytelen sorok kimaradnak az
  // összegzésekből, de a naplóban és az exportban láthatók maradnak.
  ervenyes                    Boolean   @default(true)
  ervenytelenitveAt           DateTime?
  ervenytelenitesOka          String?   @db.VarChar(300)
  ervenytelenitoFelhasznaloId Int?

  // Szövegjavítás (cím/leírás) nyoma. A mennyiségi mezők NEM szerkeszthetők,
  // mert azok a tényleges műveleti rekordot (Etetes/Kivetel/...) tükrözik.
  szerkesztveAt           DateTime?
  szerkesztoFelhasznaloId Int?

  // relációk
  // AUDIT-DÖNTÉS: a tó törlése többé NEM törli a naplót (Cascade → SetNull),
  // az auditnapló a tó megszűnése után is megmarad.
  to             To?          @relation(fields: [toId], references: [azonosito], onDelete: SetNull)
  halfaj         Halfaj?      @relation(fields: [halfajId], references: [azonosito], onDelete: SetNull)
  felhasznalo    Felhasznalo? @relation("NaploRogzito", fields: [felhasznaloId], references: [azonosito], onDelete: SetNull)
  ervenytelenito Felhasznalo? @relation("NaploErvenytelenito", fields: [ervenytelenitoFelhasznaloId], references: [azonosito], onDelete: SetNull)
  szerkeszto     Felhasznalo? @relation("NaploSzerkeszto", fields: [szerkesztoFelhasznaloId], references: [azonosito], onDelete: SetNull)
  halaszat       Halaszat?    @relation(fields: [halaszatId], references: [azonosito], onDelete: Cascade)

  @@index([toId, datum])
  @@index([tipus, datum])
  @@index([felhasznaloId])
  @@index([halaszatId, datum])
  @@map("naplo_esemenyek")
}

enum HibabejelentesStatusz {
  UJ
  FOLYAMATBAN
  MEGOLDVA
  ELUTASITVA
}

// ── Halkeltetés (Sprint 1: kézi ciklus-rögzítés) ────────────────────────────

enum HalkeltetesStatusz {
  TERVEZET
  FOLYAMATBAN
  LEZARVA
}

enum HalkeltetesIvar {
  IKRAS // nőstény / ikrás
  TEJES // hím / tejes
}

/// Egy ikráztatási/keltetési ciklus fejadatai (a keltetési munkalap "fejléce").
model HalkeltetesCiklus {
  azonosito    Int                @id @default(autoincrement())
  halaszatId   Int
  halfajId     Int?
  protokollId  Int?
  nev          String?            @db.VarChar(160)
  datum        DateTime
  oltasIdopont DateTime?
  homersekletC Decimal?           @db.Decimal(4, 1)
  statusz      HalkeltetesStatusz @default(TERVEZET)
  megjegyzes   String?            @db.Text

  // A protokoll értékei a ciklus rögzítésekor lemásolódnak (snapshot), hogy egy
  // későbbi protokoll-módosítás ne írja át visszamenőleg a számított adagokat.
  ikrasEloadagMgPerKg Decimal? @db.Decimal(8, 3)
  ikrasDontoMgPerKg   Decimal? @db.Decimal(8, 3)
  ikrasMlPerKg        Decimal? @db.Decimal(8, 3)
  tejesMgPerKg        Decimal? @db.Decimal(8, 3)
  tejesMlPerKg        Decimal? @db.Decimal(8, 3)
  rahagyasSzorzo      Decimal? @db.Decimal(4, 2)

  // actor / nyomon követhetőség
  rogzitoFelhasznaloId Int?

  letrehozva DateTime @default(now())
  frissitve  DateTime @updatedAt

  halaszat  Halaszat              @relation(fields: [halaszatId], references: [azonosito], onDelete: Cascade)
  halfaj    Halfaj?               @relation(fields: [halfajId], references: [azonosito], onDelete: SetNull)
  protokoll HalkeltetesProtokoll? @relation(fields: [protokollId], references: [azonosito], onDelete: SetNull)
  rogzito   Felhasznalo?          @relation(fields: [rogzitoFelhasznaloId], references: [azonosito], onDelete: SetNull)
  halak     HalkeltetesHal[]

  @@index([halaszatId, datum])
  @@index([halfajId])
  @@map("halkeltetes_ciklusok")
}

/// Egy ciklus egy hala (ikrás vagy tejes sor a munkalapon).
model HalkeltetesHal {
  azonosito    Int             @id @default(autoincrement())
  ciklusId     Int
  ivar         HalkeltetesIvar
  sorszam      Int?
  chipAzonosito String?        @db.VarChar(80)
  fajtaJeloles String?         @db.VarChar(120)
  tomegKg      Decimal?        @db.Decimal(7, 2)
  ikraKg       Decimal?        @db.Decimal(7, 2) // ikrás sornál: kifejt ikra tömege
  tejMl        Decimal?        @db.Decimal(8, 2) // tejes sornál: tej mennyiség
  megjegyzes   String?         @db.Text

  letrehozva DateTime @default(now())
  frissitve  DateTime @updatedAt

  ciklus HalkeltetesCiklus @relation(fields: [ciklusId], references: [azonosito], onDelete: Cascade)

  @@index([ciklusId, ivar])
  @@map("halkeltetes_halak")
}

/// Konfigurálható oltási protokoll (mg/kg, ml/kg értékek + ráhagyás szorzó).
/// Szándékosan NINCS beégetett "biológiai igazság" — halászatonként/fajonként állítható.
model HalkeltetesProtokoll {
  azonosito           Int      @id @default(autoincrement())
  halaszatId          Int
  halfajId            Int?
  nev                 String   @db.VarChar(160)
  ikrasEloadagMgPerKg Decimal  @default(0.000) @db.Decimal(8, 3)
  ikrasDontoMgPerKg   Decimal  @default(0.000) @db.Decimal(8, 3)
  ikrasMlPerKg        Decimal  @default(0.000) @db.Decimal(8, 3)
  tejesMgPerKg        Decimal  @default(0.000) @db.Decimal(8, 3)
  tejesMlPerKg        Decimal  @default(0.000) @db.Decimal(8, 3)
  rahagyasSzorzo      Decimal  @default(1.10) @db.Decimal(4, 2)
  aktiv               Boolean  @default(true)
  letrehozva          DateTime @default(now())
  frissitve           DateTime @updatedAt

  halaszat Halaszat            @relation(fields: [halaszatId], references: [azonosito], onDelete: Cascade)
  halfaj   Halfaj?             @relation(fields: [halfajId], references: [azonosito], onDelete: SetNull)
  ciklusok HalkeltetesCiklus[]

  @@index([halaszatId, aktiv])
  @@map("halkeltetes_protokollok")
}

// ── Feladatok (feladatkezelés / csapat-koordináció) ─────────────────────────

enum FeladatStatusz {
  UJ
  FOLYAMATBAN
  KESZ
  ELHALASZTVA
  TOROLVE
}

enum FeladatPrioritas {
  ALACSONY
  NORMAL
  MAGAS
  SURGOS
}

/// Egy feladat, amelyet ADMIN/OWNER oszthat ki dolgozóknak, határidővel és színnel.
model Feladat {
  azonosito              Int              @id @default(autoincrement())
  halaszatId             Int
  toId                   Int?
  cim                    String           @db.VarChar(200)
  leiras                 String?          @db.Text
  statusz                FeladatStatusz   @default(UJ)
  prioritas              FeladatPrioritas @default(NORMAL)
  szin                   String?          @db.VarChar(20)
  hatarido               DateTime?
  felelosFelhasznaloId   Int?
  letrehozoFelhasznaloId Int?
  elkeszultAt            DateTime?
  letrehozva             DateTime         @default(now())
  frissitve              DateTime         @updatedAt

  halaszat          Halaszat     @relation(fields: [halaszatId], references: [azonosito], onDelete: Cascade)
  to                To?          @relation(fields: [toId], references: [azonosito], onDelete: SetNull)
  felelosFelhasznalo   Felhasznalo? @relation("FeladatFelelos", fields: [felelosFelhasznaloId], references: [azonosito], onDelete: SetNull)
  letrehozoFelhasznalo Felhasznalo? @relation("FeladatLetrehozo", fields: [letrehozoFelhasznaloId], references: [azonosito], onDelete: SetNull)

  @@index([halaszatId, statusz])
  @@index([felelosFelhasznaloId, statusz])
  @@index([toId])
  @@index([hatarido])
  @@index([letrehozva])
  @@map("feladatok")
}

model NaptarBejegyzes {
  azonosito  Int      @id @default(autoincrement())
  halaszatId Int
  datum      DateTime @db.Date
  cim        String   @db.VarChar(200)
  tartalom   String?  @db.Text
  szin       String?  @db.VarChar(20)
  letrehozva DateTime @default(now())
  frissitve  DateTime @updatedAt

  halaszat Halaszat @relation(fields: [halaszatId], references: [azonosito], onDelete: Cascade)

  @@index([halaszatId, datum])
  @@map("naptar_bejegyzesek")
}

model Takarmany {
  azonosito  Int      @id @default(autoincrement())
  halaszatId Int
  nev        String   @db.VarChar(120)
  egyseg     String   @db.VarChar(20)
  keszlet    Decimal  @default(0.00) @db.Decimal(10, 2)
  szin       String?  @db.VarChar(20)
  aktiv      Boolean  @default(true)
  letrehozva DateTime @default(now())
  frissitve  DateTime @updatedAt

  halaszat Halaszat          @relation(fields: [halaszatId], references: [azonosito], onDelete: Cascade)
  mozgasok TakarmanyMozgas[]
  etetesek Etetes[]

  @@unique([halaszatId, nev])
  @@index([halaszatId, aktiv])
  @@map("takarmanyok")
}

model TakarmanyMozgas {
  azonosito   Int                  @id @default(autoincrement())
  takarmanyId Int
  halaszatId  Int
  tipus       TakarmanyMozgasTipus
  mennyiseg   Decimal              @db.Decimal(10, 2)
  datum       DateTime             @default(now())
  megjegyzes  String?              @db.Text
  letrehozva  DateTime             @default(now())

  // opcionális visszakötés ahhoz, ami a mozgást kiváltotta (nyomon követhetőség).
  // nullable: a kézi (etetéshez nem kötött) mozgások továbbra is érvényesek.
  toId        Int?
  etetesId    Int?

  // Actor: ki rögzítette a mozgást (bevétel/felhasználás), sessionből.
  // Nullable: régi sorok + rendszer-generált mozgások megmaradnak.
  felhasznaloId Int?

  takarmany   Takarmany    @relation(fields: [takarmanyId], references: [azonosito], onDelete: Cascade)
  halaszat    Halaszat     @relation(fields: [halaszatId], references: [azonosito], onDelete: Cascade)
  to          To?          @relation(fields: [toId], references: [azonosito], onDelete: SetNull)
  etetes      Etetes?      @relation(fields: [etetesId], references: [azonosito], onDelete: SetNull)
  felhasznalo Felhasznalo? @relation(fields: [felhasznaloId], references: [azonosito], onDelete: SetNull)

  @@index([takarmanyId, datum])
  @@index([halaszatId, datum])
  @@index([toId])
  @@index([etetesId])
  @@index([felhasznaloId])
  @@map("takarmany_mozgasok")
}

model Hibabejelentes {
  azonosito Int                   @id @default(autoincrement())
  targy     String                @db.VarChar(150)
  leiras    String                @db.Text
  oldalUrl  String?               @db.VarChar(500)
  statusz   HibabejelentesStatusz @default(UJ)

  halaszatId    Int?
  felhasznaloId Int?

  letrehozva DateTime @default(now())
  frissitve  DateTime @updatedAt

  halaszat    Halaszat?    @relation(fields: [halaszatId], references: [azonosito], onDelete: SetNull)
  felhasznalo Felhasznalo? @relation(fields: [felhasznaloId], references: [azonosito], onDelete: SetNull)

  @@index([halaszatId])
  @@index([felhasznaloId])
  @@index([statusz])
  @@index([letrehozva])
  @@map("hibabejelentesek")
}
